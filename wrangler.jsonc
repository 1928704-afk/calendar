{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendar",
  "main": "./worker.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "build": {
    "command": "cd frontend && npm install && npm run build"
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calendar-db"
    }
  ]
}
